# Supabase Postgres. Transaction pooler (6543) for the app, session pooler (5432) for migrations.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
APP_URL="http://localhost:3000"
SEED_USER_EMAIL="eshmum@digitalceo.local"
SEED_USER_PASSWORD="ChangeMe!CEO2026"
COMPANY_NAME="Eshmum eSIM"
WEBHOOK_SECRET="replace-with-a-long-random-string"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL_WRITING="anthropic/claude-3.5-sonnet"
OPENROUTER_MODEL_GENERAL="openai/gpt-4o-mini"
OPENROUTER_MODEL_RESEARCH="x-ai/grok-beta"
OPENROUTER_MODEL_FAST="deepseek/deepseek-chat"
OPENROUTER_MODEL_VISION="google/gemini-flash-1.5"
LLM_FALLBACK="mock"
AUTO_MODE="false"
KILL_SWITCH="manual"
# Optional IMAP / CalDAV — leave empty to use dashboard seed + n8n later
IMAP_HOST=""
IMAP_USER=""
IMAP_PASS=""
CALDAV_URL=""
CALDAV_USER=""
CALDAV_PASS=""
WHATSAPP_WEBHOOK_URL=""
